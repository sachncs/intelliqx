# IntelliqX local infrastructure credentials.
#
# Copy this file to .env.compose before running `docker compose up -d`:
#   cp .env.compose.example .env.compose
#
# Every variable below is read by docker-compose.yml; values left empty
# will cause `docker compose config` to fail loudly, which is the
# intended behaviour — the platform refuses to ship MinIO/Grafana with
# default credentials.

# MinIO root account used by intelliqx-storage. Generate with:
#   openssl rand -hex 24
MINIO_ROOT_USER=replace-me-minio-user
MINIO_ROOT_PASSWORD=replace-me-minio-password

# Grafana admin password for the observability profile. Generate with:
#   openssl rand -hex 24
GF_SECURITY_ADMIN_PASSWORD=replace-me-grafana-password

# OpenAI-compatible credentials passed through to the LiteLLM proxy.
# Leave OPENAI_API_KEY empty to keep the proxy in fake mode.
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
